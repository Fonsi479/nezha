[Unit]
Description=Nezha Monitoring Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nezha
Group=nezha
WorkingDirectory=/opt/nezha/agent
ExecStart=/opt/nezha/agent/nezha-agent -c /etc/nezha/agent.yaml
Environment=SSL_CERT_FILE=/etc/nezha/dashboard-ca.crt
Environment=GOMEMLIMIT=48MiB
Environment=GOMAXPROCS=1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/nezha
MemoryHigh=96M
MemoryMax=128M

[Install]
WantedBy=multi-user.target
